NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/centinell
# Required: generate a unique value, for example with `openssl rand -base64 48`.
JWT_SECRET=
ANTHROPIC_API_KEY=
# Required for paid self-service registration through Payhip. Never expose this value in the browser.
PAYHIP_API_KEY=
PAYHIP_PRODUCT_KEY=
# Public Payhip checkout URL; it may be exposed to the browser.
PAYHIP_CHECKOUT_URL=
PAYHIP_ENFORCE_BILLING=true
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
EVIDENCE_KMS_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=centinell-evidence
AUDIT_ANCHOR_URL=
AUDIT_ANCHOR_SECRET=
VIRUSTOTAL_API_KEY=
TAXII_OBJECTS_URL=
TAXII_TOKEN=
METRICS_TOKEN=
SUPPORT_EMAIL=support@centinellsuitedefence.com
# Required in production: comma-separated HTTPS origins, without trailing slashes.
ALLOWED_ORIGINS=https://forensics.example.com
